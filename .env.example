# A Postgres connection string. For local dev, run your own Postgres and point
# here; for production, use your Neon (or other Postgres host) connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/timescheduler"

# Secret used to sign session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
